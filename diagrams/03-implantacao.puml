@startuml
' Portal de Internacionalização · Grupo 08 · Proposta 4 · Sprint M1
title UML 03 — Implantação: cenário técnico proposto
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam ArrowColor #4E7298
skinparam NodeBackgroundColor #EAF4FF
skinparam NodeBorderColor #4275A4
skinparam ArtifactBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #EEEAFE

node "Dispositivo do usuário\n<<device>>" as DEVICE {
 artifact "Navegador\ncelular ou computador" as BROWSER
}
node "Hospedagem da interface web\n<<node>>" as FRONTEND {
 artifact "Portal público\ne painel editorial" as UI
}
node "Servidor / serviço de aplicação\n<<node>>" as BACKEND {
 artifact "API: consulta, busca\ne catálogo" as API
 artifact "Autenticação, permissões\ne gestão editorial" as AUTH
}
node "Serviço de dados\n<<node>>" as DATA {
 database "Orientações, fontes,\ncategorias e histórico" as DB
}
cloud "Fontes institucionais externas\nlinks para documentos e contatos" as EXTERNAL
BROWSER --> UI : HTTPS
UI --> API : HTTPS
UI --> AUTH : HTTPS
API --> DB : conexão segura restrita
AUTH --> DB : conexão segura restrita
UI ..> EXTERNAL : navegação por links oficiais
note bottom of BACKEND
 Cenário conceitual: sem provedor,
 configuração nem implantação definida na M1.
end note
@enduml
