@startuml
title Portal de Internacionalização — Diagrama UML de Casos de Uso
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Visitante" as Visitante
actor "Estudante" as Estudante
actor "Docente" as Docente
actor "Editor" as Editor
actor "Publicador" as Publicador
actor "Administrador" as Administrador

Estudante --|> Visitante
Docente --|> Visitante

rectangle "Portal de Internacionalização" {
  usecase "(RF01–RF04)\nConsultar orientações" as UC1
  usecase "(RF02)\nPesquisar conteúdos" as UC2
  usecase "(RF03)\nFiltrar por categoria" as UC3
  usecase "(RF05, RF06, RF08)\nConsultar fontes e contatos" as UC4
  usecase "(RF07)\nSelecionar idioma" as UC5
  usecase "(RF09)\nAutenticar-se" as UC6
  usecase "(RF10–RF11)\nCadastrar/editar conteúdos" as UC7
  usecase "(RF12)\nRevisar/publicar conteúdos" as UC8
  usecase "(RF14)\nAdministrar permissões" as UC9
}
Visitante -- UC1
Visitante -- UC2
Visitante -- UC3
Visitante -- UC4
Visitante -- UC5
Editor -- UC6
Editor -- UC7
Publicador -- UC6
Publicador -- UC8
Administrador -- UC6
Administrador -- UC9

note bottom of UC8
  Apenas responsáveis autorizados.
  Fluxo editorial proposto,
  ainda não validado institucionalmente.
end note
@enduml
